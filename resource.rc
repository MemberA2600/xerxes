IDD_SoundSettings DIALOG 0,0,227,166
STYLE WS_POPUP | WS_BORDER | WS_DLGFRAME | WS_SYSMENU | DS_3DLOOK | DS_MODALFRAME
FONT 8, "MS Shell Dlg"
CAPTION "SFX & Music Settings"
BEGIN
  CONTROL "0",IDF_SoundTrack,"MSCTLS_TRACKBAR32",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | TBS_AUTOTICKS,10,20,156,20
  CONTROL "Volume of Sound Effects",IDF_LABELSfxVol,"STATIC",WS_CHILD | WS_VISIBLE | WS_GROUP | SS_LEFT,10,4,82,12
  CONTROL "0",IDF_SoundValue,"INTEGERSPIN",WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP | ES_LEFT | ES_RIGHT | ES_MULTILINE,174,24,40,14
  CONTROL "0",IDF_MusicValue,"INTEGERSPIN",WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | ES_LEFT | ES_RIGHT | ES_MULTILINE,174,81,40,14
  CONTROL "0",IDF_MusicTrack,"MSCTLS_TRACKBAR32",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | TBS_AUTOTICKS,10,77,156,20
  CONTROL "Volume of Music",IDF_LABELMusicVol,"STATIC",WS_CHILD | WS_VISIBLE | WS_GROUP | SS_LEFT,10,63,82,12
  CONTROL "OPL2 Emulation",IDF_MusicRadio1,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_AUTORADIOBUTTON | BS_TEXT,10,46,78,14
  CONTROL "Real OPL2LPT",IDF_MusicRadio2,"BUTTON",WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTORADIOBUTTON | BS_TEXT,10,101,78,14
  CONTROL "LPT HEX Address:",IDF_HEX,"STATIC",WS_CHILD | WS_VISIBLE | WS_GROUP | SS_LEFT,10,120,67,12
  CONTROL "0378",IDF_LPTPort,"EDIT",WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP | ES_LEFT | ES_UPPERCASE,81,118,40,14
  CONTROL "OK",ID_SoundOK,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,46,144,40,14
  CONTROL "Cancel",ID_SoundCancel,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,93,144,40,14
  CONTROL "Reset",ID_SoundReset,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,141,144,40,14
  CONTROL "Test",ID_SoundTest,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,124,4,40,14
  CONTROL "Test",ID_MusicTest,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,124,63,40,14
  CONTROL "Test",ID_MusicTest2,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,124,119,40,14
  CONTROL "Stop",ID_MusicStop,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,170,63,40,14
  CONTROL "Stop",ID_MusicStop2,"BUTTON",WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_PUSHBUTTON | BS_TEXT,170,119,40,14
END

